# Caddyfile — GENERATED BY TERRAFORM (infra/proxy.tf). Do not edit on the box:
# the next redeploy overwrites it. Change infra/ and re-apply.
# Environment: ${environment}
# TLS mode:    ${tls_mode}
{
%{ if tls_mode == "acme" ~}
	# PUBLIC TLS TERMINATES HERE AND NOWHERE ELSE. There is no CDN or proxy in
	# front of this box, so Caddy's automatic HTTPS (ACME, Let's Encrypt) is the
	# only thing standing between the public internet and cleartext. It issues on
	# first start and renews at ~30 days remaining, in-process.
	#
	# Requirements, all of which are enforced elsewhere in this stack:
	#   - the hostnames below resolve to this instance's address (Namecheap, by
	#     hand — see infra/dns.tf);
	#   - :80 and :443 are reachable from the whole internet (security.tf), because
	#     ACME validation comes from unannounced addresses in several regions.
	email ${acme_email}
%{ if acme_ca_directory != "" ~}
	# Non-default ACME directory — a staging/rehearsal endpoint. Certificates from
	# it are NOT trusted by browsers; that is intentional during a drill.
	acme_ca ${acme_ca_directory}
%{ endif ~}
	# Certificates and the ACME account key live on the instance's own disk, so
	# REPLACING THE INSTANCE MEANS RE-ISSUING EVERY CERTIFICATE. Let's Encrypt
	# allows 5 duplicate certificates per week for the same set of names; rebuild
	# a box more often than that and issuance starts failing. Use
	# acme_ca_directory (staging) when rehearsing.
	storage file_system /var/lib/caddy
%{ else ~}
	# Automatic HTTPS is off: certificates are supplied out of band (tls_mode
	# "static") or there is no TLS at all ("none"). Caddy must not try to obtain
	# its own, or every start would burn a failed ACME order.
	auto_https off
%{ endif ~}
	admin off
}

%{ if tls_mode == "static" ~}
# Anything arriving on plain HTTP is redirected; the origin only serves HTTPS.
# (With tls_mode = "acme", Caddy creates this redirect itself.)
:80 {
	redir https://{host}{uri} permanent
}
%{ endif ~}
%{ for r in routes ~}
# ---- ${r.service} ----
%{ if tls_mode == "none" ~}
${join(", ", [for h in r.hostnames : "http://${h}"])} {
%{ else ~}
${join(", ", [for h in r.hostnames : "https://${h}"])} {
%{ endif ~}
%{ if tls_mode == "static" ~}
	tls /etc/caddy/tls.crt /etc/caddy/tls.key
%{ endif ~}
	# Mirrors nginx `client_max_body_size ${r.max_body_size}`.
	request_body {
		max_size ${r.max_body_size}
	}

%{ if !r.sse ~}
	encode zstd gzip
%{ else ~}
	# NO `encode` on an SSE route: compression buffers, which is exactly what
	# breaks event streams.
%{ endif ~}
	reverse_proxy ${join(" ", r.upstreams)} {
%{ if length(r.upstreams) > 1 ~}
		lb_policy round_robin
		# Passive health checking: take an upstream out after 3 failures rather
		# than keep sending traffic into a dead replica.
		fail_duration 30s
		max_fails 3
%{ endif ~}
%{ if r.sse ~}
		# Equivalent of nginx `proxy_buffering off` — flush every write straight
		# through so Server-Sent Events arrive as they are produced instead of
		# being held in a proxy buffer.
		flush_interval -1
%{ endif ~}
		transport http {
			# Equivalent of nginx `proxy_read_timeout ${r.read_timeout}`.
			read_timeout ${r.read_timeout}
			dial_timeout 10s
		}

		# The apps read X-Real-IP (nginx set it today), so keep setting it.
		# X-Forwarded-For/-Proto/-Host are set by Caddy already; re-declaring
		# them is a no-op that `caddy validate` warns about.
		header_up X-Real-IP {remote_host}
	}
}
%{ endfor ~}
