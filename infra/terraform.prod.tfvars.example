# terraform.prod.tfvars — production.
#
#   terraform workspace select prod
#   terraform plan -var-file=terraform.prod.tfvars
#
# Read the whole file before applying. Two things in here are deliberate CHANGES
# to today's topology, not codifications of it, and both need sign-off:
#
#  1. WAITLIST PRODUCTION AND THE APEX MARKETING SITE MOVE HERE.
#     Today they run on `host-a` — the same box as dev, staging and blue.
#     A dev deploy can therefore take down the public marketing site and the
#     waitlist. Putting them in the prod workspace fixes that, but it is a
#     migration with a DNS cutover, so they are `enabled = false` below until
#     someone schedules it.
#
#  2. `api` runs replicas instead of PM2 cluster mode. Today prod runs
#     storytime-api-production in cluster mode with max(2, cpus-1) workers. Set
#     replicas to match the instance you choose; the proxy round-robins across
#     them. This is not automatic — pick the number on purpose.

environment   = "prod"
aws_region    = "eu-west-1"
vpc_cidr      = "10.43.0.0/16"
instance_type = "t3.medium" # 4 GiB; raise to t3.large if the budget guard complains

root_volume_size = 60

# Production queues carry unsent emails, pending push notifications and in-flight
# TTS batches. Losing them when the box is replaced is real user-visible work lost,
# so once prod is on its own box a managed Redis becomes worth its ~$12/mo.
redis_mode             = "elasticache"
redis_node_type        = "cache.t4g.small"
redis_maxmemory_policy = "noeviction"

# Likewise: on a dedicated prod box, PITR is worth +$12.41/mo over a ~24h dump RPO.
use_managed_database = true
db_instance_class    = "db.t4g.micro"

# Required — and deliberately NOT assigned here: a -var-file value outranks the
# environment, so assigning "" would discard your export and fail the guard.
#
#   export TF_VAR_db_password='...'


# The legacy shared instance, looked up READ-ONLY during the migration so its
# endpoint appears in outputs. Terraform never modifies it. "" to skip.
shared_db_identifier = ""

services = {
  # storytime-api-production (PM2 cluster mode, max(2, cpus-1) workers)
  "api" = {
    container_port = 3000
    host_port      = 3000
    hostnames      = ["api.storytimeapp.me"]
    replicas       = 2 # PM2 cluster-mode equivalent; size the instance to match
    sse            = true
    max_body_size  = "25m"
    read_timeout   = "3600s"
    health_path    = "/health"
    memory_mb      = 768 # x2 replicas = 1536 MiB against the budget
  }

  # storytime-fe-prod (PM2, port 3000)
  "web" = {
    container_port = 3000
    host_port      = 3100
    hostnames      = ["web.storytimeapp.me"]
    memory_mb      = 1024
  }

  # storytime-superadmin-prod (PM2, port 3505)
  "admin" = {
    container_port = 3505
    host_port      = 3505
    hostnames      = ["admin.storytimeapp.me"]
    memory_mb      = 512
  }

  # ---- currently on the SHARED dev box; enable only with a planned cutover ----

  # storytime-waitlist-production (PM2, port 4500)
  "waitlist-web" = {
    container_port = 4500
    host_port      = 4500
    hostnames      = ["waitlist.storytimeapp.me"]
    enabled        = false
    memory_mb      = 512
  }

  # storytime-waitlist-api-production
  # PORT UNKNOWN (PM2 default 3000; real port never recorded). Confirm from the
  # capture output before enabling.
  "waitlist-api" = {
    container_port = 3000
    host_port      = 4600
    hostnames      = []
    enabled        = false
  }
}

config_plain = {
  "api" = {
    NODE_ENV = "production"
    PORT     = "3000"
  }
}

secret_keys = {
  # Populate from the capture output. Names only.
}

secret_values = {
  # NEVER COMMIT. Supply via TF_VAR_secret_values or this gitignored file.
}

# Production MUST have a TLS path, and on this design there is exactly one:
# Caddy, on the box, with Let's Encrypt. Nothing sits in front of it, so a
# certificate failure is an outage — guards.tf refuses tls_mode = "none" here
# unless allow_plaintext_origin says so explicitly. Children's personal data does
# not travel in cleartext by omission.
tls_mode               = "acme"
acme_email             = "REPLACE_WITH_A_MONITORED_ALIAS"
allow_plaintext_origin = false

# The A records for the hostnames above must already point at this stack's
# Elastic IP before the first apply can obtain certificates:
#   terraform output dns_records_required   -> type them into Namecheap by hand
#
# After that, a rebuild or a migration inside this AWS account moves the ELASTIC
# IP and touches no DNS at all:
# eip_allocation_id = "eipalloc-..."   # take over the live address
# associate_eip     = true             # false while verifying a replacement

manage_shared_ecr  = false
# MUST STAY FALSE: account 772316781095 already has the GitHub OIDC provider
# (created by the FateRound stack); a second one for the same URL fails the apply.
manage_github_oidc = false
